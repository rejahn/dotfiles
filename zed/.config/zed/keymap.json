// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Editor && vim_mode == normal && vim_operator == none && !VimWaiting",
    "bindings": {
      "space f": "file_finder::Toggle",
      "space d": "editor::GoToDiagnostic",
      "space s": "outline::Toggle",
      "space S": "project_symbols::Toggle",
      "space e": "workspace::ToggleLeftDock",
      "space t": "workspace::ToggleBottomDock",
      "space /": "pane::DeploySearch",
      "space r": "search::ToggleReplace",
      "space c": "editor::ToggleComments",
      "space a": "editor::ToggleCodeActions",
      "g a": "pane::ActivatePreviousItem",
    }
  },
  {
    "context": "Editor",
    "bindings": {
      // "g e": "editor::GoToDiagnostic"
      // "j k": ["workspace::SendKeystrokes", "escape"]
    }
  },
  {
    "context": "Pane",
    "bindings": {
      "ctrl-tab": "pane::ActivateNextItem",
      "ctrl-shift-tab": "pane::ActivatePreviousItem",
      "space f": "file_finder::Toggle",
      "space s": "outline::Toggle",
      "space S": "project_symbols::Toggle",
      "space e": "workspace::ToggleLeftDock",
      "space t": "workspace::ToggleBottomDock",
    }
  },
  {
    "context": "ProjectPanel",
    "bindings": {
      "escape": "workspace::ToggleLeftDock"
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      "cmd-n": "workspace::NewTerminal",
      "cmd-d": "pane::CloseActiveItem",
      "cmd-t": "workspace::ToggleBottomDock",
      "cmd-shift-f": "workspace::ToggleZoom",
      "escape": "workspace::ToggleBottomDock"
    }
  },
  {
    "context": "BufferSearchBar",
    "bindings": {
      "space r": "search::ToggleReplace"
    }
  },
  {
    "context": "vim_operator == a || vim_operator == i || vim_operator == cs",
    "bindings": {
      // Traditional Vim behavior
      "q": "vim::AnyQuotes",
      "b": "vim::AnyBrackets",
      // mini.ai plugin behavior
      "Q": "vim::MiniQuotes",
      "B": "vim::MiniBrackets"
    }
  }
]
